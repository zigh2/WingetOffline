<Window x:Class="WingetOffline.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WingetOffline.UI.ViewModels"
        xmlns:views="clr-namespace:WingetOffline.UI.Views"
        Title="WingetOffline" Width="1320" Height="800" MinWidth="980" MinHeight="580"
        Background="{DynamicResource BgBrush}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:DiscoverViewModel}"><views:DiscoverView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:InstalledListViewModel}"><views:InstalledView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:InstallersViewModel}"><views:InstallersView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><views:PlaceholderView/></DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- الشريط الجانبي -->
    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource NavBgBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="20,22,20,18">
          <TextBlock Text="WingetOffline" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Offline package manager" Style="{StaticResource SubtleText}" FontSize="11"/>
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                 Style="{StaticResource NavListStyle}" ItemContainerStyle="{StaticResource NavItemStyle}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Width="30" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="{Binding State.CatalogInfo}" Style="{StaticResource SubtleText}"
                   FontSize="11" TextWrapping="Wrap" Margin="20,10,20,10"/>

        <!-- ثيم بضغطة واحدة -->
        <Button Grid.Row="3" Style="{StaticResource NavFooterButton}"
                Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeTip}"
                AutomationProperties.Name="{Binding ThemeTip}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding ThemeGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                       Width="30" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ThemeLabel}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- الصفحة الحالية -->
    <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding CurrentPage}"/>

    <!-- شريط الحالة -->
    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource NavBgBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding State.StatusText}" Style="{StaticResource SubtleText}" FontSize="12"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <ProgressBar Grid.Column="1" Width="140" Height="4" IsIndeterminate="True" Margin="12,0,0,0"
                     Visibility="{Binding State.IsBusy, Converter={StaticResource BoolToVis}}"/>
      </Grid>
    </Border>
  </Grid>
</Window>
