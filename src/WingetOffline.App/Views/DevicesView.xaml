<UserControl x:Class="WingetOffline.UI.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28,20,28,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Devices" Style="{StaticResource TitleText}"/>
      <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,0,8"
                 Text="See the programs installed on the other computers of your local network and which ones have an update, using each computer's own offline catalog. This version is read-only: nothing is installed, removed or run on those computers. Each computer must run wgo-agent and be paired by comparing fingerprints."/>
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="This computer's fingerprint" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox Grid.Column="1" Text="{Binding MyFingerprint, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 ToolTip="Give this to each agent: wgo-agent trust &lt;fingerprint&gt; &lt;label&gt;"/>
        <Button Grid.Column="2" Content="Copy" Command="{Binding CopyMyFingerprintCommand}" Margin="8,0,0,0"/>
      </Grid>
    </StackPanel>

    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <Button Content="Refresh all" Style="{StaticResource AccentButton}" Command="{Binding RefreshAllCommand}" Margin="0,0,8,6"
              ToolTip="Ask every device for its installed programs (read-only)"/>
      <Button Content="Refresh selected" Command="{Binding RefreshSelectedCommand}" Margin="0,0,8,6"/>
      <Button Content="Test connection" Command="{Binding PingSelectedCommand}" Margin="0,0,8,6"/>
      <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,6"/>
      <Button Content="Export report" Command="{Binding ExportReportCommand}" Margin="0,0,8,6"
              ToolTip="Fleet report from the saved scans: HTML, CSV (updates) or JSON. Works offline."/>
      <Button Content="Forget selected" Command="{Binding RemoveSelectedCommand}" Margin="0,0,16,6"/>
      <TextBlock Text="{Binding Summary}" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="0,0,0,6" TextWrapping="Wrap"/>
    </WrapPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- الأجهزة + نموذج الإضافة -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected, Mode=TwoWay}" HorizontalContentAlignment="Stretch">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="2,4">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Address}" Style="{StaticResource SubtleText}" FontSize="11"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource SubtleText}" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource WarnBrush}" Text="{Binding Updates, StringFormat={}{0} update(s) available}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Updates}" Value="0">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
          <TextBlock Text="Add a device" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Text="Name" Style="{StaticResource LabelText}"/>
          <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
          <TextBlock Text="Address and port (from wgo-agent id)" Style="{StaticResource LabelText}"/>
          <TextBox Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" ToolTip="For example 192.168.1.20:51234. Only private network addresses are accepted."/>
          <TextBlock Text="Agent fingerprint (64 characters)" Style="{StaticResource LabelText}"/>
          <TextBox Text="{Binding NewFingerprint, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11" Margin="0,0,0,6"
                   ToolTip="Type or paste it from the agent's own screen, not from a message you cannot verify."/>
          <TextBlock Text="{Binding FormError}" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <Button Content="Add device" Command="{Binding AddCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Grid>

      <!-- برامج الجهاز المحدد -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel>
          <StackPanel Margin="0,0,12,8">
            <TextBlock Text="Filter" Style="{StaticResource LabelText}"/>
            <TextBox Width="240" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by name or package id"/>
          </StackPanel>
          <CheckBox Content="Updates only" IsChecked="{Binding UpdatesOnly}" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
        </WrapPanel>
        <TextBlock Grid.Row="1" Text="{Binding AppsSummary}" Style="{StaticResource SubtleText}" Margin="0,0,0,8"/>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Apps}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="170"/>
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Installed" Binding="{Binding Version}" Width="1.1*" MinWidth="100"/>
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Latest" Binding="{Binding LatestVersion}" Width="1.1*" MinWidth="100"/>
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Status" Binding="{Binding StatusText}" Width="1.2*" MinWidth="120"/>
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Package ID" Binding="{Binding PackageId}" Width="2*" MinWidth="150"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
