<UserControl x:Class="WingetOffline.UI.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="28,20" MaxWidth="640" HorizontalAlignment="Left">
    <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}"/>
    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Style="{StaticResource SubtleText}"/>
  </StackPanel>
</UserControl>
