<UserControl x:Class="WingetOffline.UI.Views.SelfTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WingetOffline.UI.ViewModels">
  <Grid Margin="28,20,28,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Self-test" Style="{StaticResource TitleText}"/>
      <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,0,10"
                 Text="Runs the automatic checks on this computer (file readers, hashes, export/import, exclusions, library, catalog, your installed programs, wgo and Builder) and lists the checks only a person can do. Nothing is installed or removed, your library and settings are not changed, and the report can be saved and sent."/>
    </StackPanel>

    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <Button Content="Run all checks" Style="{StaticResource AccentButton}" Command="{Binding RunCommand}" Margin="0,0,8,6"/>
      <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,6"/>
      <Button Content="Export report" Command="{Binding ExportReportCommand}" Margin="0,0,8,6"
              ToolTip="Save everything (automatic results + manual checklist) as Markdown or JSON"/>
      <Button Content="Copy report" Command="{Binding CopyReportCommand}" Margin="0,0,20,6"/>
      <CheckBox Content="Deep checks (uses your library folders and a 20 s drive walk; slower)" IsChecked="{Binding DeepChecks}" Margin="0,4,16,6"/>
      <CheckBox Content="Online checks (downloads one small program)" IsChecked="{Binding OnlineChecks}" Margin="0,4,16,6"/>
      <CheckBox Content="Hide my user name and machine name in the report" IsChecked="{Binding Redact}" Margin="0,4,0,6"/>
    </WrapPanel>

    <StackPanel Grid.Row="2" Margin="0,0,0,10">
      <ProgressBar Height="6" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"/>
      <TextBlock Text="{Binding StatusLine}" Style="{StaticResource SubtleText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Margin="0,2,0,0"/>
    </StackPanel>

    <TabControl Grid.Row="3">
      <TabItem Header="Automatic checks">
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="170" ItemsSource="{x:Static vm:SelfTestViewModel.FilterOptions}" SelectedItem="{Binding Filter}"/>
          </StackPanel>

          <DataGrid Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected, Mode=TwoWay}" Margin="0,0,12,0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource GridText}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Status}" Value="FAIL">
                        <Setter Property="Foreground" Value="#E5484D"/><Setter Property="FontWeight" Value="Bold"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="WARN">
                        <Setter Property="Foreground" Value="#F5A623"/><Setter Property="FontWeight" Value="SemiBold"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="PASS">
                        <Setter Property="Foreground" Value="#30A46C"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="ID" Binding="{Binding Id}" Width="70"/>
              <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Group" Binding="{Binding Category}" Width="100"/>
              <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Check" Binding="{Binding Name}" Width="2*" MinWidth="180"/>
              <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Test plan" Binding="{Binding PlanIds}" Width="110"/>
              <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="ms" Binding="{Binding Ms}" Width="60"/>
              <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Result" Binding="{Binding Message}" Width="3*" MinWidth="200"/>
            </DataGrid.Columns>
          </DataGrid>

          <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12">
            <Grid>
              <TextBlock Text="Select a check to see its details" Style="{StaticResource SubtleText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding Selected, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
              <TextBox Text="{Binding Selected.Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                       Visibility="{Binding Selected, Converter={StaticResource NullToVis}}"/>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Manual checklist">
        <Grid Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{Binding ManualSummary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Reset all" Command="{Binding ResetManualCommand}"/>
            <TextBlock Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="16,0,0,0"
                       Text="Your answers are saved automatically and included in the exported report. The steps match docs/TEST-PLAN.md."/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Manual}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="260"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Priority}" Style="{StaticResource SubtleText}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="0,0,16,0" FlowDirection="RightToLeft">
                        <TextBlock Text="{Binding Action}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Expected}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                      </StackPanel>
                      <ComboBox Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Top"
                                ItemsSource="{x:Static vm:ManualRow.ResultOptions}" SelectedItem="{Binding Result}"/>
                      <TextBox Grid.Column="3" Text="{Binding Note, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34"
                               ToolTip="Your note: what you saw (copied into the report)"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
